# Copy to override.env (ignored by git) for app-level overrides.
# Values here override upstream.env.

# Disable the input backup:
# BACKUP=false

# Delete backups older than N days (0 disables cleanup):
# BACKUP_RETENTION_DAYS=30

# Disable recursive structure mirroring (not recommended for ABS):
# REPLICATE_SOURCE_DIR_STRUCTURE=false

# Always append RENAME_SUFFIX to output filenames:
# OUTPUT_SUFFIX=true

# Overwrite the source file in place (requires a writable /data/in):
# OVERWRITE_SOURCE_FILE=true

# Reduce log output:
# LOG_LEVEL=WARNING

# Process once instead of running as a loop:
# LOOP=false

# Only process matching files:
# FILENAME_FILTER=*Harry*.m4b

# Custom tag mapping:
# TAG_MAP=[{"from":"album","to":"series"},{"from":"track","to":"series-part"},{"from":"title","to":"album"}]

# Custom value replacements:
# TAG_RULES=[{"tag":"album","old":"Old Album","new":"New Album"}]
