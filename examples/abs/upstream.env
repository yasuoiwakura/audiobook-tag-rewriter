# Committed defaults for the all-in-one ABS stack.
# Keep in sync with ../../upstream.env, except for the ABS-specific settings.
# Override locally in override.env (later file wins).

# Input: AudioBookConverter output or manual drop folder
INPUT_DIR=/data/in
# Output: mounted into Audiobookshelf as /audiobooks
OUTPUT_DIR=/data/out
# Backup of the input file before processing
BACKUP_DIR=/data/backup
BACKUP=true
BACKUP_RETENTION_DAYS=30

FILENAME_FILTER=*.m4b
RECURSIVE=false
# ABS expects one folder per book; mirror nested source directories.
REPLICATE_SOURCE_DIR_STRUCTURE=true
OUTPUT_SUFFIX=false
OVERWRITE_SOURCE_FILE=false
OVERWRITE_EXISTING=false
LOG_LEVEL=INFO

OUTPUT_SAME_DIR=false
RENAME_SUFFIX=[TAGS_REMAPPED]
SKIP_SUFFIX=true

LOOP=true
LOOP_INTERVAL=60

# Optional YAML configuration:
# CONFIG_FILE=/config/config.yml

# Without TAG_MAP/TAG_RULES the default mapping is used:
# album -> series, track -> series-part, title -> album
