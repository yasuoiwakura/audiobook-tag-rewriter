# Compose interpolation for examples/abs.
# Copy to .env; .env is ignored by git.
# App-level overrides belong in override.env, not here.

# Fixer image and ABS image
IMAGE_TAG=latest
ABS_IMAGE_TAG=latest

# ABS web UI (host port)
ABS_PORT=13378
TZ=Europe/Berlin

# Host paths (relative to this compose.yml)
HOST_INPUT_DIR=./data/in
HOST_OUTPUT_DIR=./data/out
HOST_BACKUP_DIR=./data/backup
HOST_CONFIG_DIR=./config

# ABS data
HOST_ABS_CONFIG_DIR=./abs/config
HOST_ABS_METADATA_DIR=./abs/metadata
