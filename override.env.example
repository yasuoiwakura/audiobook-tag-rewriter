# Copy to override.env (ignored by git) for local/container overrides.
# Values here override upstream.env. A local .env overrides this file again.
# Note: HOST_* paths for Docker mounts are Compose interpolation variables and
# belong in .env, not here.

# Disable the input backup:
# BACKUP=false

# Delete backups older than N days (0 disables cleanup):
# BACKUP_RETENTION_DAYS=30

# Search input recursively and mirror subdirectories under OUTPUT_DIR:
# REPLICATE_SOURCE_DIR_STRUCTURE=true

# Always append RENAME_SUFFIX to output filenames:
# OUTPUT_SUFFIX=true

# !!! WARNUNG !!!
# BACKUP=true wird bei OVERWRITE_SOURCE_FILE=true DRINGEND EMPFOHLEN.
# Ohne Backup wird die Quelldatei unwiderruflich überschrieben.
# OVERWRITE_SOURCE_FILE=true

# Reduce log output (INFO already keeps idle loops silent):
# LOG_LEVEL=WARNING

# Only process matching files:
# FILENAME_FILTER=*Harry*.m4b

# Process once instead of running as a loop:
# LOOP=false

# Custom tag mapping:
# TAG_MAP=[{"from":"album","to":"series"},{"from":"track","to":"series-part"},{"from":"title","to":"album"}]

# Custom value replacements:
# TAG_RULES=[{"tag":"album","old":"Old Album","new":"New Album"}]
