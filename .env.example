# Local overrides for compose.yml (loaded last).
# Copy to .env; .env is ignored by git.

# Image tag used by Compose interpolation (not a container setting):
# IMAGE_TAG=latest

# Host paths for Compose interpolation (optional; defaults are in compose.yml).
# Relative paths are relative to compose.yml. Absolute paths are allowed.
# HOST_INPUT_DIR=./m4b_from_AudioBookConverter
# HOST_OUTPUT_DIR=./m4b_for_AudioBookShelf
# HOST_BACKUP_DIR=./m4b_backup
# HOST_CONFIG_DIR=./config

# Disable the backup of the input file:
# BACKUP=false

# Delete backups older than N days (0 disables cleanup):
# BACKUP_RETENTION_DAYS=30

# Search input recursively and mirror subdirectories under OUTPUT_DIR:
# REPLICATE_SOURCE_DIR_STRUCTURE=true

# Always append RENAME_SUFFIX to output filenames:
# OUTPUT_SUFFIX=true

# !!! WARNING !!!
# BACKUP=true is STRONGLY RECOMMENDED with OVERWRITE_SOURCE_FILE=true.
# Without a backup, the source file is overwritten irreversibly.
# OVERWRITE_SOURCE_FILE=true

# Reduce log output (INFO already keeps idle loops silent):
# LOG_LEVEL=WARNING

# Process once instead of running as a loop:
# LOOP=false

# Limit which files are processed:
# FILENAME_FILTER=*Harry*.m4b

# Custom tag mapping:
# TAG_MAP=[{"from":"album","to":"series"},{"from":"track","to":"series-part"},{"from":"title","to":"album"}]

# Custom value replacements:
# TAG_RULES=[{"tag":"album","old":"Old Album","new":"New Album"}]

# Optional YAML configuration (inside the container):
# CONFIG_FILE=/config/config.yml
