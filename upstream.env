# Committed defaults for the Docker Compose service.
# Override locally in override.env or .env (later files win).

# Input: AudioBookConverter output
INPUT_DIR=/data/in
# Output: library folder for Audiobookshelf
OUTPUT_DIR=/data/out
# Backup of the input file before processing
BACKUP_DIR=/data/backup
BACKUP=true
BACKUP_RETENTION_DAYS=30

FILENAME_FILTER=*.m4b
RECURSIVE=false
REPLICATE_SOURCE_DIR_STRUCTURE=false
OUTPUT_SUFFIX=false
# !!! WARNING !!!
# BACKUP=true is STRONGLY RECOMMENDED with OVERWRITE_SOURCE_FILE=true.
# Without a backup, the source file is overwritten irreversibly.
OVERWRITE_SOURCE_FILE=false
OVERWRITE_EXISTING=false
LOG_LEVEL=INFO

OUTPUT_SAME_DIR=false
RENAME_SUFFIX=[TAGS_REMAPPED]
SKIP_SUFFIX=true

LOOP=true
LOOP_INTERVAL=60

# Optional YAML configuration:
# CONFIG_FILE=/config/config.yml

# Without TAG_MAP/TAG_RULES the default mapping is used:
# album -> series, track -> series-part, title -> album
# TAG_MAP=[{"from":"album","to":"series"},{"from":"track","to":"series-part"},{"from":"title","to":"album"}]
# TAG_RULES=[{"tag":"album","old":"Old Album","new":"New Album"}]
